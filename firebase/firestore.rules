rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (AUTHENTICATION & AUTHORIZATION)
    // =========================================================================
    
    // Returns true if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Returns true if the authenticated user matches the specified userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. MULTI-TENANT USER ROOT & SUBCOLLECTIONS
    // Path: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      // Direct access to user profile document
      allow read, write: if isOwner(userId);

      // Subcollection: Conversations
      // Path: /users/{userId}/conversations/{conversationId}
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);

        // Subcollection: Messages
        // Path: /users/{userId}/conversations/{conversationId}/messages/{messageId}
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Subcollection: Long-Term Memories
      // Path: /users/{userId}/memories/{memoryId}
      match /memories/{memoryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && request.resource.data.userId == userId;
      }

      // Subcollection: Settings
      // Path: /users/{userId}/settings/{settingsDoc}
      match /settings/{settingsDoc} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Documents (PDF RAG Metadata & Vector Chunks)
      // Path: /users/{userId}/documents/{documentId}
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);

        // Subcollection: Document Chunks
        // Path: /users/{userId}/documents/{documentId}/chunks/{chunkId}
        match /chunks/{chunkId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // =========================================================================
    // 2. DOCUMENTS COLLECTION (RAG Metadata)
    // Path: /documents/{documentId}
    // =========================================================================
    match /documents/{documentId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Subcollection: Document Chunks
      // Path: /documents/{documentId}/chunks/{chunkId}
      match /chunks/{chunkId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/documents/$(documentId)).data.userId == request.auth.uid;
        allow write: if isAuthenticated() && 
          request.resource.data.userId == request.auth.uid;
      }
    }

    // =========================================================================
    // 3. USAGE METRICS (Internal / Admin Only)
    // Path: /usage_metrics/{metricId}
    // =========================================================================
    match /usage_metrics/{metricId} {
      allow read, write: if false; // Only accessible via Firebase Admin SDK
    }
  }
}
